# Only the toolkit is tracked. Every project created here with new-project.sh is its own repository, and
# workspace/ (private notes and plans) is a separate private one.
/*
!/.gitignore
!/.claude-plugin/
!/README.md
!/LICENSE
!/GUIDE.md
!/PIPELINE.md
!/setup.sh
!/new-project.sh
!/spring-boot-learning/
!/skills/

# build output and installs inside the toolkit
target/
node_modules/
spring-boot-learning/kit-check/reviewer-eval/work/
.DS_Store
.env
.env.*
!/docs/
