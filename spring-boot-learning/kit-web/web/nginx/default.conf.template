# Rendered at container start by the image's envsubst step: ${API_UPSTREAM} becomes e.g. http://app:8080.
# Only variables set in the environment are replaced, so nginx's own $uri, $host stay as they are.
server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    # The API, same origin: the browser never talks to the app directly, so no CORS to configure.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Built assets have a content hash in their names: cache them for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Everything else is the single-page app; index.html is never cached, so a deploy is picked up at once.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
